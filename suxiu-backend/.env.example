# 苏绣 AI 后端 - 环境变量配置
# 复制此文件为 .env 并填入实际配置

# 应用配置
APP_NAME=苏绣 AI 后端
APP_VERSION=1.0.0
DEBUG=True

# JWT 配置 - 生产环境必须修改!
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# 数据库配置
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/suxiu_ai

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
ALIYUN_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET

# 通义万相 API Key
DASHSCOPE_API_KEY=sk-xxx

# OSS 配置
OSS_BUCKET=suxiu-ai-designs
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
